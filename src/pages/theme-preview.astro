---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Doors from '../components/Doors.astro';
import ReferrerSection from '../components/ReferrerSection.astro';
import Acknowledgement from '../components/Acknowledgement.astro';
import Fees from '../components/Fees.astro';

const themes = [
  {
    id: 'theme-0',
    name: '0 — Current',
    note: 'Baseline for comparison. This is the "too poppy" version.',
    swatches: [
      ['ink', '#3E2A1C'], ['rust', '#C0551E'], ['gold', '#DFA22C'],
      ['olive', '#6E7B45'], ['chalk', '#9DB2B2'], ['wheat', '#F1E4CB'], ['paper', '#FCF6E9'],
    ],
  },
  {
    id: 'theme-1',
    name: '1 — Muted Terracotta',
    note: 'Same palette, chroma pulled back ~30%. Safest, closest match to the original idea.',
    swatches: [
      ['ink', '#362A20'], ['rust', '#A2593D'], ['gold', '#C29752'],
      ['olive', '#6B7350'], ['chalk', '#9AACAA'], ['wheat', '#EEE3CE'], ['paper', '#FBF7EF'],
    ],
  },
  {
    id: 'theme-2',
    name: '2 — Quiet Clinical',
    note: 'Most subdued option: accents shifted toward gray-brown, no bright orange or yellow anywhere. Best bet if the goal is maximum professional confidence.',
    swatches: [
      ['ink', '#33291F'], ['rust', '#8C5C48'], ['gold', '#A98A56'],
      ['olive', '#66694F'], ['chalk', '#93A3A1'], ['wheat', '#E7DFCF'], ['paper', '#F8F5EE'],
    ],
  },
  {
    id: 'theme-3',
    name: '3 — Deep Editorial',
    note: 'Darker and richer rather than paler — brick/antique-gold instead of candy-bright. Reads as gravitas rather than "calm."',
    swatches: [
      ['ink', '#2A2018'], ['rust', '#8C4128'], ['gold', '#A9822F'],
      ['olive', '#545C3B'], ['chalk', '#85999A'], ['wheat', '#E4D6B8'], ['paper', '#F6EFE0'],
    ],
  },
  {
    id: 'theme-4',
    name: '4 — Sage-Led Warm',
    note: 'Rebalances the hierarchy: gold becomes a near-neutral background tint, olive/sage carries the secondary-accent role instead. Removes the two-bright-accent clash rather than just muting each one.',
    swatches: [
      ['ink', '#37291D'], ['rust', '#A85940'], ['gold', '#C9AD74'],
      ['olive', '#707C58'], ['chalk', '#9FB3AE'], ['wheat', '#EFE7D4'], ['paper', '#FBF8F1'],
    ],
  },
  {
    id: 'theme-1',
    name: '5 — No Inverse Text (on Muted Terracotta)',
    note: 'Same palette as option 1, but removes every white-on-chocolate (and white-on-olive) block: the clinician door, the Acknowledgement band, and the "help paying" panel are now light backgrounds with dark text, using a tinted chalk/olive panel or border to keep the audience signal instead of a dark reversed fill. This layout change is independent of palette — it can be applied on top of any of options 1–4 too.',
    swatches: [
      ['ink', '#362A20'], ['rust', '#A2593D'], ['gold', '#C29752'],
      ['olive', '#6B7350'], ['chalk', '#9AACAA'], ['wheat', '#EEE3CE'], ['paper', '#FBF7EF'],
    ],
    noInverse: true,
    extra: true,
  },
];
---
<BaseLayout title="Theme preview">
  <style define:vars={{}}>
    .preview-intro{max-width:780px;margin:0 auto;padding:40px 24px 0;font-family:var(--body);color:#333}
    .preview-intro h1{font-family:var(--disp);font-size:32px;margin:0 0 12px}
    .theme-label{max-width:1080px;margin:0 auto;padding:48px 24px 0}
    .theme-label h2{font-family:var(--disp);font-size:24px;margin:0 0 4px;color:#222}
    .theme-label p{font-family:var(--body);font-size:15px;color:#555;margin:0 0 16px;max-width:70ch}
    .swatch-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
    .swatch{width:88px;font-family:var(--body);font-size:11px;text-align:center}
    .swatch .chip{height:56px;border-radius:8px;border:1px solid rgba(0,0,0,.12);margin-bottom:4px}
    .theme-block{border:2px dashed #ccc;margin:0 24px 8px;border-radius:12px;overflow:hidden}
    hr.sep{border:none;border-top:1px solid #ddd;margin:0}
  </style>

  <div class="preview-intro">
    <h1>Colour theme review</h1>
    <p>Same layout (hero → family/clinician doors → referrer block), five palettes. Scroll through and tell me which number(s) you like, or mix elements across them (e.g. "1's gold with 2's rust").</p>
  </div>

  {themes.map((t) => (
    <>
      <div class="theme-label">
        <h2>{t.name}</h2>
        <p>{t.note}</p>
        <div class="swatch-row">
          {t.swatches.map(([label, hex]) => (
            <div class="swatch">
              <div class="chip" style={`background:${hex}`}></div>
              {label} {hex}
            </div>
          ))}
        </div>
      </div>
      <div class:list={['theme-block', 'kE', 'E-site', t.id, t.noInverse && 'no-inverse']}>
        <Hero />
        <Doors />
        <ReferrerSection />
        {t.extra && <Acknowledgement />}
        {t.extra && <Fees />}
      </div>
      <hr class="sep" />
    </>
  ))}

  <style>
    /* Theme 1 — Muted Terracotta */
    .kE.theme-1{
      --ink:#362A20; --rust:#A2593D; --gold:#C29752; --olive:#6B7350;
      --chalk:#9AACAA; --wheat:#EEE3CE; --paper:#FBF7EF;
    }
    /* Theme 2 — Quiet Clinical */
    .kE.theme-2{
      --ink:#33291F; --rust:#8C5C48; --gold:#A98A56; --olive:#66694F;
      --chalk:#93A3A1; --wheat:#E7DFCF; --paper:#F8F5EE;
    }
    /* Theme 3 — Deep Editorial */
    .kE.theme-3{
      --ink:#2A2018; --rust:#8C4128; --gold:#A9822F; --olive:#545C3B;
      --chalk:#85999A; --wheat:#E4D6B8; --paper:#F6EFE0;
    }
    /* Theme 4 — Sage-Led Warm */
    .kE.theme-4{
      --ink:#37291D; --rust:#A85940; --gold:#C9AD74; --olive:#707C58;
      --chalk:#9FB3AE; --wheat:#EFE7D4; --paper:#FBF8F1;
    }

  </style>

  <style is:global>
    /* No-inverse layout override: replaces dark reversed-text fills with
       tinted light backgrounds + dark text, using border/tint instead of
       fill colour to keep the audience signal. Composable with any theme.
       Global because .E-door/.E-ack/.E-money are rendered inside child
       components and wouldn't be reachable by this page's scoped styles. */
    .no-inverse .E-door.fam{
      background:var(--paper);
    }
    .no-inverse .E-door.fam h2{ color:var(--olive); }
    .no-inverse .E-door.fam .E-btn{ background:var(--olive); color:var(--paper); }

    .no-inverse .E-door.clin{
      background:color-mix(in srgb, var(--chalk) 30%, var(--paper));
      color:var(--ink);
      border-left:6px solid var(--chalk);
    }
    .no-inverse .E-door.clin h2{ color:var(--ink); }
    .no-inverse .E-door.clin p{ color:color-mix(in srgb, var(--ink) 78%, transparent); }

    .no-inverse .E-ack{
      background:var(--wheat);
      color:var(--ink);
      border-top:3px solid var(--ink);
      border-bottom:3px solid var(--ink);
    }
    .no-inverse .E-ack h2{ color:var(--rust); }
    .no-inverse .E-ack p{ color:color-mix(in srgb, var(--ink) 88%, transparent); }

    .no-inverse .E-money > div:last-child{
      background:var(--paper);
      color:var(--ink);
      border-color:var(--olive);
      border-width:3px;
    }
    .no-inverse .E-money > div:last-child h3{ color:var(--olive); }
    .no-inverse .E-money > div:last-child .note{ opacity:.72; }
  </style>
</BaseLayout>
