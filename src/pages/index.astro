---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Hero from '../components/Hero.astro';
import Doors from '../components/Doors.astro';
import LifeStages from '../components/LifeStages.astro';
import HowIWork from '../components/HowIWork.astro';
import InclusionPanel from '../components/InclusionPanel.astro';
import About from '../components/About.astro';
import Acknowledgement from '../components/Acknowledgement.astro';
import Fees from '../components/Fees.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <div class="E-site">
    <TopNav />
    <Hero />
    <main id="main">
      <Doors />
      <LifeStages />
      <HowIWork />
      <InclusionPanel />
      <About />
      <Acknowledgement />
      <Fees />
    </main>
    <Footer />
  </div>
</BaseLayout>
