---
import '../styles/reset.css';
import '../styles/palette.css';
import '../styles/site.css';

const {
  title = 'Otella Speech + Swallow: speech pathology, Umina Beach',
  description = 'Adult speech pathology in Umina Beach: communication and swallowing rehabilitation after stroke, neurological diagnosis, surgery or head and neck cancer, plus voice and fluency care. Direct bookings and specialist referrals.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <script is:inline>
    try {
      if (localStorage.getItem('otella-gate') === 'ok') {
        document.documentElement.classList.add('gate-open');
      }
    } catch (e) {}
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#EEE3CE" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..700&family=Nunito+Sans:ital,wght@0,300..800;1,400..700&display=swap" rel="stylesheet">
  <style>
    .E-construction-banner {
      background: var(--rust);
      color: var(--paper);
      font-family: var(--body);
      font-weight: 700;
      text-align: center;
      padding: 0.65rem 1rem;
      letter-spacing: 0.02em;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    html:not(.gate-open) {
      overflow: hidden;
    }
    .E-gate {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: var(--wheat);
      font-family: var(--body);
    }
    html.gate-open .E-gate {
      display: none;
    }
    .E-gate-form {
      width: 100%;
      max-width: 360px;
      background: var(--paper);
      border: 3px solid var(--ink);
      border-radius: 20px;
      padding: 36px 32px;
      text-align: center;
    }
    .E-gate-label {
      font-family: var(--disp);
      font-size: 20px;
      color: var(--ink);
      margin: 0 0 20px;
      line-height: 1.3;
    }
    .E-gate-form input[type="password"] {
      width: 100%;
      box-sizing: border-box;
      font-family: var(--body);
      font-size: 16px;
      padding: 12px 14px;
      border: 2px solid var(--ink);
      border-radius: 10px;
      background: var(--paper);
      color: var(--ink);
      margin-bottom: 14px;
    }
    .E-gate-form .E-btn {
      width: 100%;
      cursor: pointer;
    }
    .E-gate-error {
      color: var(--rust);
      font-weight: 700;
      font-size: 14px;
      margin: 14px 0 0;
    }
  </style>
</head>
<body class="kE">
  <a class="E-skip" href="#main">Skip to content</a>
  <div class="E-gate" role="dialog" aria-modal="true" aria-labelledby="gateLabel">
    <form class="E-gate-form" id="gateForm" autocomplete="off">
      <p class="E-gate-label" id="gateLabel">This site is under construction.<br />Enter the password to continue.</p>
      <input type="password" id="gatePassword" name="password" placeholder="Password" aria-label="Password" autofocus required />
      <button type="submit" class="E-btn">Enter</button>
      <p class="E-gate-error" id="gateError" hidden>Incorrect password. Try again.</p>
    </form>
  </div>
  <div class="E-construction-banner" id="constructionBanner" role="status">Site under construction: content and details are still being finalised</div>
  <slot />
  <script is:inline>
    (function () {
      var banner = document.getElementById('constructionBanner');
      if (!banner) return;
      function setBannerHeight() {
        document.documentElement.style.setProperty('--banner-h', banner.getBoundingClientRect().height + 'px');
      }
      setBannerHeight();
      window.addEventListener('resize', setBannerHeight);
      window.addEventListener('load', setBannerHeight);
    })();
  </script>
  <script is:inline>
    (function () {
      var form = document.getElementById('gateForm');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var input = document.getElementById('gatePassword');
        if (input.value === 'laura') {
          try { localStorage.setItem('otella-gate', 'ok'); } catch (err) {}
          document.documentElement.classList.add('gate-open');
        } else {
          document.getElementById('gateError').hidden = false;
          input.value = '';
          input.focus();
        }
      });
    })();
  </script>
</body>
</html>
