---
import { Image } from 'astro:assets';
import portrait from '../assets/laura-hero.jpg';
import { PHONE, PHONE_TEL, EMAIL } from '../data/contact.js';
---
<div class="E-hero">
  <div class="E-in">
    <div class="grid">
      <div>
        <h1>Adult speech, voice and swallowing rehabilitation.</h1>
        <p>Evidence-based assessment and therapy for acquired communication and swallowing disorders.</p>
        <p style="font-size:19px;color:rgba(62,42,28,.78)">Welcome to Otella Speech + Swallow, a private Speech Pathology practice based in Umina Beach specialising in adult communication and swallowing disorders. I'm Laura, a Certified Practising Speech Pathologist, and I work with adults following stroke, a neurological diagnosis or surgery, as well as speech, voice and fluency concerns that have never had the chance to be assessed. I work closely with ENT, neurology, gastroenterology and general practice colleagues to ensure coordinated, evidence-based care, and as a solo practitioner you see the same clinician at every appointment.</p>
        <div class="row">
          <a class="E-btn" href={`tel:${PHONE_TEL}`}>Ring {PHONE}</a>
          <a class="E-btn alt" href={`mailto:${EMAIL}`}>Send me a note</a>
          <span style="font-size:16px;color:rgba(62,42,28,.72)">First call is free. About three weeks to an appointment.</span>
        </div>
      </div>
      <div style="display:flex;justify-content:center">
        <div class="E-portrait">
          <Image src={portrait} width={780} height={780} quality={90} alt="Laura, speech pathologist at Otella Speech and Swallow" />
        </div>
      </div>
    </div>
  </div>
</div>
