---
import { PHONE, PHONE_TEL, EMAIL } from '../data/contact.js';
---
<div class="E-in E-doors-band">
  <div class="E-doors">
    <div class="E-door fam">
      <h2>For adults and families</h2>
      <p>Changes in speech or language since a stroke, a voice that's changed, meals that have started ending in coughing, or a longstanding speech or voice concern that's never been assessed.</p>
      <ul>
        <li>No referral needed</li>
        <li>Free fifteen-minute call first</li>
        <li>NDIS, Medicare and private health</li>
      </ul>
      <a class="E-btn" href={`tel:${PHONE_TEL}`}>Ring {PHONE}</a>
    </div>
    <div class="E-door clin" id="for-referrers">
      <h2>For referring clinicians</h2>
      <p>Referrals accepted from ENT, gastroenterology, neurology, geriatrics and general practice. Scope, turnaround and limits are published rather than negotiated case by case.</p>
      <ul>
        <li>Secure messaging, or scanned to {EMAIL}</li>
        <li>Seen within 10 working days, report back within 5</li>
        <li>One clinician: no triage queue, no handover</li>
      </ul>
      <a class="E-btn cool" href="/referrers">Referral information</a>
    </div>
  </div>
</div>
