---
import SwallowArt from './SwallowArt.astro';

interface Props { size?: number }
const { size = 200 } = Astro.props;
const outerClip = `decal-outer-${crypto.randomUUID()}`;
const swallowClip = `decal-swallow-${crypto.randomUUID()}`;
---
<svg width={size} height={size} viewBox="0 0 168 168" role="img" aria-label="All welcome here decal">
  <defs><clipPath id={outerClip}><circle cx="84" cy="84" r="57"/></clipPath></defs>
  <circle cx="84" cy="84" r="79" fill="#FCF6E9" stroke="#3E2A1C" stroke-width="3"/>
  <g clip-path={`url(#${outerClip})`} transform="translate(84,84) scale(1.263) translate(-84,-84)">
    <rect x="27" y="27" width="114" height="19" fill="#B8412A"/>
    <rect x="27" y="46" width="114" height="19" fill="#D9782E"/>
    <rect x="27" y="65" width="114" height="19" fill="#DFA22C"/>
    <rect x="27" y="84" width="114" height="19" fill="#6E7B45"/>
    <rect x="27" y="103" width="114" height="19" fill="#4A6E8A"/>
    <rect x="27" y="122" width="114" height="19" fill="#6B4A7A"/>
    <path d="M27 27 L27 141 L62 84 Z" fill="#7FC3E8"/>
    <path d="M27 45 L27 123 L51 84 Z" fill="#E8A0B8"/>
    <path d="M27 63 L27 105 L40 84 Z" fill="#FCF6E9"/>
    <g transform="translate(84,84) scale(1.096) translate(-60,-60)">
      <defs><clipPath id={swallowClip}><circle cx="60" cy="60" r="52"/></clipPath></defs>
      <g clip-path={`url(#${swallowClip})`}>
        <g transform="translate(60,60) scale(0.1925) translate(-688.5,-402.15)">
          <SwallowArt mode="mono" monoFill="#3E2A1C" />
        </g>
      </g>
    </g>
  </g>
  <circle cx="84" cy="84" r="72" fill="none" stroke="#3E2A1C" stroke-width="2.5"/>
</svg>
