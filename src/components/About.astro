---
import { Image } from 'astro:assets';
import portrait from '../assets/laura-about-me.jpg';
const facts = [
  'Certified Practising Speech Pathologist',
  'Speech Pathology Australia',
  'NDIS registered',
];
---
<div class="E-in" style="padding-top:70px">
  <div class="E-me">
    <div style="display:flex;justify-content:center">
      <div class="E-portrait-sq">
        <Image src={portrait} width={580} height={580} quality={90} alt="Laura, speech pathologist at Otella Speech and Swallow" loading="eager" />
      </div>
    </div>
    <div>
      <h2 class="E-h2">A bit about me</h2>
      <p>I trained as a speech pathologist in Sydney before relocating to the Central Coast in 2013. I spent six years working across acute stroke and head and neck oncology lists at Gosford Hospital, which remains the clinical foundation for the swallowing and voice rehabilitation work I do today. I now direct Otella Speech and Swallow as a solo private practice, working alongside ENT, neurology, gastroenterology and general practice colleagues across the region.</p>
      <ul class="E-facts">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </div>
</div>
