---
import Logo from './Logo.astro';
import { PHONE, PHONE_TEL, EMAIL, ADDRESS_LINE2, ABN, HOURS } from '../data/contact.js';
const updated = new Date().toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<footer class="E-foot">
  <div class="E-in">
    <div class="cols">
      <div class="brand"><Logo width={252} /></div>
      <div><b>Where to find me</b>{ADDRESS_LINE2}<br />Parking out the back</div>
      <div><b>Getting in touch</b>{HOURS}<br /><a href={`tel:${PHONE_TEL}`}>{PHONE}</a><br /><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
    </div>
    <div class="fine">
      <p>ABN {ABN}</p>
      <p>If someone is choking, or speech or swallowing has changed suddenly, ring 000. This page isn't for emergencies.</p>
      <p>I work on Darkinjung land. Sovereignty was never ceded.</p>
      <p>Updated {updated}</p>
    </div>
  </div>
</footer>
