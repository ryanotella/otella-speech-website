---
const services = [
  {
    fill: '#3E2A1C',
    icon: '<path d="M13 29 A10 10 0 0 1 33 29M17 22 A6 6 0 0 1 29 22" fill="none" stroke="#DFA22C" stroke-width="3.2" stroke-linecap="round"/>',
    title: "The words won't come out",
    body: "Aphasia and dysarthria after stroke, brain injury, or a neurodegenerative condition such as Parkinson's or MND.",
    who: 'Neuro · GP',
  },
  {
    fill: '#C0551E',
    icon: '<path d="M20 14c0 4-4 5-4 9s4 5 4 9M26 14c0 4 4 5 4 9s-4 5-4 9" fill="none" stroke="#FCF6E9" stroke-width="3" stroke-linecap="round"/>',
    title: 'After a head and neck cancer diagnosis',
    body: 'Speech, voice and swallowing support around treatment for head and neck cancer, including laryngectomy and changes after surgery or radiotherapy.',
    who: 'ENT · oncology',
  },
  {
    fill: '#9DB2B2',
    icon: '<path d="M23 15v8l6 4" fill="none" stroke="#3E2A1C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>',
    title: 'Changes that come with age',
    body: 'The gradual changes to swallowing and voice that come with getting older, and the practical adjustments that help at mealtimes and day to day.',
    who: 'Geriatrics · GP',
  },
  {
    fill: '#DFA22C',
    icon: '<path d="M23 12v22M16 18l7-6 7 6" fill="none" stroke="#3E2A1C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>',
    title: 'A voice that has changed',
    body: 'Hoarseness, vocal fatigue and post-operative voice work, on referral once the larynx has been looked at.',
    who: 'ENT',
  },
  {
    fill: '#6E7B45',
    icon: '<path d="M18 13v11a5 5 0 0 0 10 0V13M23 24v9" fill="none" stroke="#FCF6E9" stroke-width="3.2" stroke-linecap="round"/>',
    title: 'Food going down the wrong way',
    body: 'Adult dysphagia: coughing at meals, food sticking, weight loss, repeated chest infections. Assessment, diet and fluid levels, and training for whoever helps at mealtimes.',
    who: 'Gastro · neuro · ENT',
  },
];
---
<div class="E-in" id="what-i-work-with" style="padding-top:70px">
  <h2 class="E-h2">Who I work with</h2>
  <p class="E-sub">Written the way people describe it on the phone, with the clinical name beside it so a referrer can find their patient just as fast. Adult clients only — no paediatric or children's services.</p>
  <ul class="E-list">
    {services.map((s) => (
      <li>
        <svg width="42" height="42" viewBox="0 0 46 46"><circle cx="23" cy="23" r="21" fill={s.fill} /><Fragment set:html={s.icon} /></svg>
        <div><b>{s.title}</b><p>{s.body}</p><span class="who">{s.who}</span></div>
      </li>
    ))}
  </ul>
</div>
