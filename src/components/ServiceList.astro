---
const services = [
  {
    fill: '#3E2A1C',
    icon: '<rect x="14" y="14" width="19" height="14" rx="4" fill="none" stroke="#DFA22C" stroke-width="2.8"/><path d="M18 32l-3 4v-4" fill="none" stroke="#DFA22C" stroke-width="2.8" stroke-linejoin="round" stroke-linecap="round"/><path d="M17.5 21c1.2-2.2 2.8-2.2 4 0c1.2 2.2 2.8 2.2 4 0c1.2-2.2 2.8-2.2 4 0" fill="none" stroke="#DFA22C" stroke-width="2.4" stroke-linecap="round"/>',
    title: 'Aphasia and dysarthria',
    body: "Difficulty finding words, or slurred and effortful speech, following stroke, brain injury, or a progressive neurological condition such as Parkinson's disease or motor neurone disease.",
    who: 'Neurology · GP',
  },
  {
    fill: '#C0551E',
    icon: '<path d="M16,15 C16,15 20,20 23,20 C26,20 30,15 30,15 M23,20 L19,33 M23,20 L27,33" fill="none" stroke="#FCF6E9" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>',
    title: 'Head and neck cancer',
    body: 'Speech, voice and swallowing support around treatment for head and neck cancer, including laryngectomy rehabilitation and changes following surgery or radiotherapy.',
    who: 'ENT · Oncology',
  },
  {
    fill: '#9DB2B2',
    icon: '<path d="M23 15v8l6 4" fill="none" stroke="#3E2A1C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>',
    title: 'Presbyphagia and presbyphonia',
    body: 'The gradual swallowing and voice changes that come with age, and the practical adjustments that help at mealtimes and day to day.',
    who: 'Geriatrics · GP',
  },
  {
    fill: '#DFA22C',
    icon: '<path d="M15,26v-6M20,29v-14M25,23v6M30,28v-12M35,25v-4" fill="none" stroke="#3E2A1C" stroke-width="2.8" stroke-linecap="round"/>',
    title: 'Dysphonia',
    body: 'Hoarseness, vocal fatigue and post-operative voice rehabilitation, on referral once the larynx has been assessed by an ENT specialist.',
    who: 'ENT',
  },
  {
    fill: '#6E7B45',
    icon: '<path d="M18 13v11a5 5 0 0 0 10 0V13M23 24v9" fill="none" stroke="#FCF6E9" stroke-width="3.2" stroke-linecap="round"/>',
    title: 'Dysphagia',
    body: 'Coughing or choking at meals, food sticking, unintended weight loss, or recurrent chest infections. Assessment of diet and fluid texture, and training for whoever helps at mealtimes.',
    who: 'Gastroenterology · Neurology · ENT',
  },
];
---
<div class="E-in" id="clinical-scope" style="padding-top:70px">
  <h2 class="E-h2">Clinical scope</h2>
  <p class="E-sub">Clinical terminology, with the everyday presentation described alongside it. Adult clients only, no paediatric or children's services.</p>
  <ul class="E-list">
    {services.map((s) => (
      <li>
        <svg width="42" height="42" viewBox="0 0 46 46"><circle cx="23" cy="23" r="21" fill={s.fill} /><Fragment set:html={s.icon} /></svg>
        <div><b>{s.title}</b><p>{s.body}</p><span class="who">{s.who}</span></div>
      </li>
    ))}
  </ul>
</div>
