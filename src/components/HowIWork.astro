---
const steps = [
  { title: 'Continuity of care', body: "The same clinician at every session, for as long as you're attending. No rotating therapists, no handover when someone goes on leave." },
  { title: 'The first call is free', body: 'A fifteen-minute phone consultation to establish whether specialist input is required.' },
  { title: 'Focused home practice', body: 'Each session concludes with a brief written summary and a small number of specific practice tasks: enough to be clinically useful, few enough to actually complete.' },
  { title: 'Discharge planned from the outset', body: "Clear discharge criteria, communicated to you and to your referring practitioner. Review continues only where it's clinically indicated." },
];
---
<div class="E-in" id="how-i-work" style="padding-top:70px">
  <h2 class="E-h2">How I work</h2>
  <p class="E-sub">Four principles, applied consistently whether you were referred by a specialist or found this page yourself.</p>
  <ol class="E-how">
    {steps.map((s) => (
      <li><div><b>{s.title}</b><p>{s.body}</p></div></li>
    ))}
  </ol>
</div>
